--- /dev/null
+++ b/Services-Deployment-main-bare_nof_modify_pressure_v3/tests/test_nof_readcache.py
@@ -0,0 +1,62 @@
+"""Exercise only the pure validation function; never run the deployment script."""
+import json
+import os
+from pathlib import Path
+import re
+import subprocess
+import tempfile
+import unittest
+
+ROOT = Path(__file__).resolve().parents[1]
+DEFAULTS = dict(NOF_READ_CACHE_MIB='0', NOF_READ_CACHE_MAX_IO_KIB='256',
+                NOF_READ_CACHE_ENABLED='1', NOF_READ_CACHE_POPULATE_ON_WRITE='0')
+
+
+class ReadcacheDeploymentTests(unittest.TestCase):
+    def test_enabling_cache_refuses_an_old_image_before_takeover(self):
+        source = (ROOT / 'services/'
+                  'k8s-2-mooncake-deployment-rank/scripts/k8s-run_mooncake_nof_target.sh').read_text()
+        function = re.search(r'require_readcache_support\(\) \{.*?\n\}', source, re.S).group()
+        with tempfile.TemporaryDirectory() as work:
+            path = Path(work) / 'target_nvme_takeover.sh'
+            for script, enabled, allowed in [
+                ('old script\n', '0', True), ('old script\n', '512', False),
+                ('READ_CACHE_ENABLED=1\nbdev_readcache_create\n', '512', True)]:
+                path.write_text(script)
+                result = subprocess.run(['bash', '-eu', '-c', function + '\nrequire_readcache_support'],
+                    env=dict(os.environ, SPDK=work, NOF_READ_CACHE_MIB=enabled), capture_output=True)
+                self.assertEqual(result.returncode == 0, allowed)
+
+    def test_parameters_reach_both_v3_targets(self):
+        for version in ('v3',):
+            for role in ('rank', 'recall'):
+                base = ROOT / 'services' / f'k8s-2-mooncake-deployment-{role}'
+                spec = json.loads((base / 'service.json').read_text())
+                start = (base / 'start.sh').read_text()
+                template = (base / '04-store-daemonset.yaml').read_text()
+                whitelist = re.search(r"envsubst\s*\\\s*'([^']+)'", start).group(1)
+                for key, value in DEFAULTS.items():
+                    self.assertEqual(spec['variables'][key], value)
+                    self.assertIn('export ' + key + '=', start)
+                    self.assertIn('${' + key + '}', whitelist)
+                    self.assertIn(f'- name: {key}\n              value: "${{{key}}}"', template)
+                match = re.search(r'validate_readcache_parameters\(\) \{.*?\n\}', start, re.S)
+                self.assertIsNotNone(match)
+                cases = [({}, True), ({'NOF_READ_CACHE_MIB': '512'}, True),
+                         ({'NOF_READ_CACHE_MIB': '512', 'NOF_READ_CACHE_ENABLED': '0'}, True),
+                         ({'NOF_READ_CACHE_MIB': '-1'}, False),
+                         ({'NOF_READ_CACHE_MIB': '08'}, False),
+                         ({'NOF_READ_CACHE_MAX_IO_KIB': '0'}, False),
+                         ({'NOF_READ_CACHE_ENABLED': 'yes'}, False),
+                         ({'NOF_READ_CACHE_POPULATE_ON_WRITE': '2'}, False),
+                         ({'BDEV_MODE': 'null', 'NOF_READ_CACHE_MIB': '512'}, False)]
+                for changes, allowed in cases:
+                    env = dict(os.environ, BDEV_MODE='nvme', **DEFAULTS)
+                    env.update(changes)
+                    code = 'die() { exit 1; };\n' + match.group() + '\nvalidate_readcache_parameters\n'
+                    result = subprocess.run(['bash', '-eu', '-c', code], env=env, capture_output=True)
+                    self.assertEqual(result.returncode == 0, allowed, (version, role, changes))
+
+
+if __name__ == '__main__':
