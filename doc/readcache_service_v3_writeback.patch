+"""Exercise W2 compare CLI using local snapshots; no remote commands."""
+import copy
+import importlib.util
+import json
+from pathlib import Path
+import subprocess
+import sys
+import tempfile
+import unittest
+
+ROOT = Path(__file__).resolve().parents[2]
+SPEC = importlib.util.spec_from_file_location('readcache_experiment_w2', ROOT / 'scripts/readcache_experiment.py')
+MODULE = importlib.util.module_from_spec(SPEC)
+SPEC.loader.exec_module(MODULE)
+
+
+def snapshots():
+    s = dict.fromkeys(MODULE.COUNTERS, 0) | dict(
+        stats_epoch=1, generation=1, enabled=True, populate_on_write=False,
+        capacity_bytes=131072, max_io_bytes=4096, allocated_bytes=12000, pinned_bytes=0,
+        write_ack_policy='volatile_early_ack_wait_read', read_commit_level='backend_complete')
+    s['writeback'] = dict.fromkeys(('accepted', 'committed', 'failed', 'accepted_bytes',
+        'committed_bytes', 'failed_bytes', 'backpressure', 'read_waits', 'read_wait_us',
+        'commit_latency_us', 'pending', 'pending_bytes', 'allocated_bytes', 'peak_bytes',
+        'max_commit_latency_us', 'active_operations'), 0)
+    s['writeback'].update(capacity_bytes=65536, max_pending_writes=32, max_dirty_age_us=1000,
+                          poisoned=False)
+    before = {'schema': 1, 'errors': [], 'targets': {'rank/target': {
+        'uid': 'uid1', 'containers': [['target', 'image', 0]],
+        'caches': {'wb': {'uuid': 'uuid1', 'base_bdev': 'raid', 'stats': s}},
+        'iostat': {'bdevs': [{'name': 'raid', 'bytes_read': 0, 'bytes_written': 0, 'num_read_ops': 0}]}}}}
+    after = copy.deepcopy(before)
+    a = after['targets']['rank/target']['caches']['wb']['stats']
+    a.update(read_requests=10, hits=10, read_bytes=40960, hit_bytes=40960)
+    a['writeback'].update(accepted=1, committed=1, accepted_bytes=4096,
+                          committed_bytes=4096, peak_bytes=8192)
+    return before, after
+
+
+class WritebackExperimentTests(unittest.TestCase):
+    def test_cli_requires_drained_error_free_w2(self):
+        for fault in (None, 'pending', 'failed', 'active_operations', 'poisoned', 'restart', 'idle'):
+            before, after = snapshots()
+            s = after['targets']['rank/target']['caches']['wb']['stats']
+            if fault == 'poisoned':
+                s['writeback']['poisoned'] = True
+            elif fault == 'restart':
+                after['targets']['rank/target']['uid'] = 'uid2'
+            elif fault == 'idle':
+                s['writeback'] = copy.deepcopy(before['targets']['rank/target']['caches']['wb']['stats']['writeback'])
+            elif fault:
+                s['writeback'][fault] = 1
+            with tempfile.TemporaryDirectory() as tmp:
+                a, b = Path(tmp) / 'before.json', Path(tmp) / 'after.json'
+                a.write_text(json.dumps(before)); b.write_text(json.dumps(after))
+                result = subprocess.run([sys.executable, str(ROOT / 'scripts/readcache_experiment.py'),
+                    'compare', str(a), str(b), '--writeback'], text=True, capture_output=True)
+                self.assertEqual(result.returncode, 0 if fault is None else 1, (fault, result.stderr))
+                self.assertEqual(json.loads(result.stdout)['valid'], fault is None)
+
+    def test_policy_change_rejected_by_normal_compare(self):
+        before, after = snapshots()
+        after['targets']['rank/target']['caches']['wb']['stats']['write_ack_policy'] = 'backend_complete'
+        self.assertFalse(MODULE.compare(before, after)['valid'])
+
+
+if __name__ == '__main__':
+    unittest.main()
