+#!/usr/bin/env python3
+"""Read-only Kubernetes cache snapshots and guarded before/after comparison."""
+import argparse
+from datetime import datetime, timezone
+import json
+from pathlib import Path
+import subprocess
+
+
+COUNTERS = ('read_requests', 'hits', 'coalesced', 'miss_leaders', 'bypasses',
+            'read_bytes', 'hit_bytes', 'coalesced_bytes', 'miss_bytes', 'bypass_bytes',
+            'fill_errors', 'io_errors', 'evictions', 'invalidations', 'write_fills',
+            'bypass_disabled', 'bypass_oversize', 'bypass_mutation', 'bypass_budget',
+            'bypass_alloc', 'bypass_invalid', 'bypass_external')
+
+
+def command_json(argv):
+    result = subprocess.run(argv, text=True, capture_output=True, timeout=120)
+    if result.returncode:
+        raise RuntimeError(f'command failed rc={result.returncode}: {result.stderr[-600:]}')
+    return json.loads(result.stdout)
+
+
+def snapshot(namespaces, context=None, rpc_path='/home/mooncake/spdk/scripts/rpc.py',
+             rpc_socket='/var/tmp/spdk.sock', require_cache=False, run=command_json):
+    kubectl = ['kubectl'] + (['--context', context] if context else [])
+    result = {'schema': 1, 'created_utc': datetime.now(timezone.utc).isoformat(),
+              'targets': {}, 'errors': []}
+    for namespace in namespaces:
+        try:
+            pods = run(kubectl + ['-n', namespace, 'get', 'pods', '-l',
+                                  'app=mooncake-store', '-o', 'json'])['items']
+            if not pods:
+                raise ValueError('no target Pods found')
+        except (RuntimeError, ValueError, KeyError) as exc:
+            result['errors'].append(f'{namespace}: {exc}')
+            continue
+        for pod in pods:
+            name = pod['metadata']['name']
+            key = f'{namespace}/{name}'
+            try:
+                if pod.get('status', {}).get('phase') != 'Running':
+                    raise ValueError('target Pod is not Running')
+                prefix = kubectl + ['-n', namespace, 'exec', name, '--', rpc_path, '-s', rpc_socket]
+                bdevs = run(prefix + ['bdev_get_bdevs'])
+                io = run(prefix + ['bdev_get_iostat'])
+                wrappers = {}
+                for bdev in bdevs:
+                    driver = bdev.get('driver_specific', {}).get('readcache')
+                    if driver is None:
+                        continue
+                    wrappers[bdev['name']] = {
+                        'uuid': bdev['uuid'], 'base_bdev': driver['base_bdev_name'],
+                        'stats': run(prefix + ['bdev_readcache_get_stats', bdev['name']])}
+                if require_cache and not wrappers:
+                    raise ValueError('no readcache bdev exported by this target')
+                containers = pod.get('status', {}).get('containerStatuses', [])
+                identity = sorted((c['name'], c.get('imageID'), c.get('restartCount'),
+                                   c.get('state', {}).get('running', {}).get('startedAt'))
+                                  for c in containers)
+                result['targets'][key] = {'uid': pod['metadata']['uid'],
+                    'containers': identity, 'caches': wrappers, 'iostat': io}
+            except (RuntimeError, ValueError, KeyError, TypeError) as exc:
+                result['errors'].append(f'{key}: {exc}')
+    return result
+
+
+def nonnegative_int(value, key):
+    if type(value) is not int or value < 0:
+        raise ValueError(f'invalid nonnegative counter {key}')
+    return value
+
+
+def compare(before, after, minimum_avoidance=0.0):
+    report = {'valid': True, 'errors': [], 'caches': {}}
+    report['errors'].extend(before.get('errors', []) + after.get('errors', []))
+    if before.get('schema') != 1 or after.get('schema') != 1:
+        report['errors'].append('unsupported snapshot schema')
+    old_targets, new_targets = before.get('targets', {}), after.get('targets', {})
+    if set(old_targets) != set(new_targets):
+        report['errors'].append('target set changed between snapshots')
+    for key in sorted(set(old_targets) & set(new_targets)):
+        old, new = old_targets[key], new_targets[key]
+        if old['uid'] != new['uid'] or old['containers'] != new['containers']:
+            report['errors'].append(f'{key}: Pod/container restarted or image changed')
+            continue
+        if set(old['caches']) != set(new['caches']):
+            report['errors'].append(f'{key}: cache bdev set changed')
+            continue
+        for name in old['caches']:
+            label = key + '/' + name
+            a, b = old['caches'][name], new['caches'][name]
+            try:
+                if a['uuid'] != b['uuid'] or a['base_bdev'] != b['base_bdev']:
+                    raise ValueError('bdev identity changed')
+                s0, s1 = a['stats'], b['stats']
+                for field in ('stats_epoch', 'generation', 'enabled', 'populate_on_write',
+                              'capacity_bytes', 'max_io_bytes'):
+                    if s0[field] != s1[field]:
+                        raise ValueError(f'{field} changed; start a new measurement window')
+                for field in ('write_ack_policy', 'read_commit_level'):
+                    if s0.get(field, 'backend_complete') != s1.get(field, 'backend_complete'):
+                        raise ValueError(f'{field} changed; start a new measurement window')
+                delta = {}
+                for field in COUNTERS:
+                    delta[field] = nonnegative_int(s1[field], field) - nonnegative_int(s0[field], field)
+                    if delta[field] < 0:
+                        raise ValueError(f'counter {field} decreased')
+                for suffix, fields in [('requests', ('hits', 'coalesced', 'miss_leaders', 'bypasses')),
+                                       ('bytes', ('hit_bytes', 'coalesced_bytes', 'miss_bytes', 'bypass_bytes'))]:
+                    if delta['read_' + suffix] != sum(delta[f] for f in fields):
+                        raise ValueError(f'read {suffix} accounting mismatch')
+                if delta['fill_errors'] or delta['io_errors']:
+                    raise ValueError('cache/backend read failures occurred')
+                if nonnegative_int(s1['allocated_bytes'], 'allocated_bytes') > s1['capacity_bytes']:
+                    raise ValueError('live allocation exceeds cache budget')
+                if nonnegative_int(s1['pinned_bytes'], 'pinned_bytes') > s1['allocated_bytes']:
+                    raise ValueError('pinned bytes exceed live allocation')
+                if not delta['read_bytes']:
+                    raise ValueError('no read bytes observed; cannot assess cache')
+                avoided = (delta['hit_bytes'] + delta['coalesced_bytes']) / delta['read_bytes']
+                if avoided < minimum_avoidance:
+                    raise ValueError(f'accounted read avoidance {avoided:.3f} below {minimum_avoidance:.3f}')
+                entry = {'delta': delta, 'accounted_read_avoidance': avoided,
+                         'allocated_bytes': s1['allocated_bytes'], 'pinned_bytes': s1['pinned_bytes']}
+                # RAID-level bytes and member-SSD bytes must not be added together.
+                # Report only this wrapper's immediate base for each window.
+                base = a['base_bdev']
+                i0 = {d['name']: d for d in old['iostat']['bdevs']}[base]
+                i1 = {d['name']: d for d in new['iostat']['bdevs']}[base]
+                entry['base_iostat_delta'] = {}
+                for field in ('bytes_read', 'bytes_written', 'num_read_ops'):
+                    value = nonnegative_int(i1[field], field) - nonnegative_int(i0[field], field)
+                    if value < 0:
+                        raise ValueError(f'base {field} decreased')
+                    entry['base_iostat_delta'][field] = value
+                report['caches'][label] = entry
+            except (ValueError, KeyError, TypeError) as exc:
+                report['errors'].append(f'{label}: {exc}')
+    if not report['caches']:
+        report['errors'].append('no comparable cache read activity')
+    report['valid'] = not report['errors']
+    return report
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    commands = parser.add_subparsers(dest='action', required=True)
+    capture = commands.add_parser('snapshot')
+    capture.add_argument('--namespace', action='append', required=True)
+    capture.add_argument('--context')
+    capture.add_argument('--rpc-path', default='/home/mooncake/spdk/scripts/rpc.py')
+    capture.add_argument('--rpc-socket', default='/var/tmp/spdk.sock')
+    capture.add_argument('--require-cache', action='store_true')
+    capture.add_argument('--output', type=Path, required=True)
+    diff = commands.add_parser('compare')
+    diff.add_argument('before', type=Path)
+    diff.add_argument('after', type=Path)
+    diff.add_argument('--minimum-avoidance', type=float, default=0.0)
+    diff.add_argument('--output', type=Path)
+    diff.add_argument('--writeback', action='store_true',
+                      help='Also require W2 activity, drain, accounting and error checks')
+    args = parser.parse_args()
+    if args.action == 'snapshot':
+        data = snapshot(args.namespace, args.context, args.rpc_path, args.rpc_socket, args.require_cache)
+        valid = not data['errors']
+    else:
+        if not 0 <= args.minimum_avoidance <= 1:
+            parser.error('--minimum-avoidance must be between 0 and 1')
+        before, after = json.loads(args.before.read_text()), json.loads(args.after.read_text())
+        data = compare(before, after, args.minimum_avoidance)
+        if args.writeback:
+            from readcache_writeback_check import check
+            data['writeback'] = check(before, after)
+            data['errors'].extend(data['writeback']['errors'])
+            data['valid'] = data['valid'] and data['writeback']['valid']
+        valid = data['valid']
+    text = json.dumps(data, ensure_ascii=False, indent=2) + '\n'
+    if args.output:
+        args.output.parent.mkdir(parents=True, exist_ok=True)
+        args.output.write_text(text)
+    print(text, end='')
+    raise SystemExit(0 if valid else 1)
+
+
+if __name__ == '__main__':
+    main()
