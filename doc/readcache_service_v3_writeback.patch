+"""Replay snapshot/compare with JSON fixtures; never invoke kubectl or SSH."""
+import copy
+import importlib.util
+from pathlib import Path
+import unittest
+
+PATH = Path(__file__).resolve().parents[2] / 'scripts/readcache_experiment.py'
+SPEC = importlib.util.spec_from_file_location('readcache_experiment', PATH)
+MODULE = importlib.util.module_from_spec(SPEC)
+SPEC.loader.exec_module(MODULE)
+
+
+def stats():
+    return dict.fromkeys(MODULE.COUNTERS, 0) | dict(
+        stats_epoch=1, generation=1, enabled=True, populate_on_write=False,
+        capacity_bytes=131072, max_io_bytes=4096, allocated_bytes=12000, pinned_bytes=0)
+
+
+def fixture():
+    return {'schema': 1, 'errors': [], 'targets': {'rank/target': {
+        'uid': 'pod-uid', 'containers': [('target', 'image-id', 0, 'started')],
+        'caches': {'cache': {'uuid': 'cache-uuid', 'base_bdev': 'raid', 'stats': stats()}},
+        'iostat': {'bdevs': [{'name': 'raid', 'bytes_read': 0, 'bytes_written': 0, 'num_read_ops': 0}]}}}}
+
+
+class ReadcacheExperimentTests(unittest.TestCase):
+    def snapshots(self):
+        before = fixture()
+        after = copy.deepcopy(before)
+        target = after['targets']['rank/target']
+        target['caches']['cache']['stats'].update(read_requests=10, miss_leaders=1,
+            coalesced=9, read_bytes=40960, miss_bytes=4096, coalesced_bytes=36864)
+        target['iostat']['bdevs'][0].update(bytes_read=4096, bytes_written=4096, num_read_ops=1)
+        return before, after
+
+    def test_fanout_window_and_base_bytes(self):
+        report = MODULE.compare(*self.snapshots(), minimum_avoidance=0.8)
+        self.assertTrue(report['valid'], report['errors'])
+        result = report['caches']['rank/target/cache']
+        self.assertEqual(result['accounted_read_avoidance'], 0.9)
+        self.assertEqual(result['base_iostat_delta']['bytes_read'], 4096)
+
+    def test_restart_reset_mode_change_and_invalid_counters_are_rejected(self):
+        for change in ('uid', 'epoch', 'enabled', 'budget', 'failure', 'accounting', 'uuid'):
+            with self.subTest(change=change):
+                before, after = self.snapshots()
+                target = after['targets']['rank/target']
+                s = target['caches']['cache']['stats']
+                if change == 'uid':
+                    target['uid'] = 'new-pod'
+                elif change == 'epoch':
+                    s['stats_epoch'] += 1
+                elif change == 'enabled':
+                    s['enabled'] = False
+                elif change == 'budget':
+                    s['allocated_bytes'] = s['capacity_bytes'] + 1
+                elif change == 'failure':
+                    s['fill_errors'] = 1
+                elif change == 'accounting':
+                    s['read_requests'] += 1
+                else:
+                    target['caches']['cache']['uuid'] = 'recreated'
+                self.assertFalse(MODULE.compare(before, after)['valid'])
+
+    def test_no_activity_and_missing_targets_are_not_success(self):
+        before, after = self.snapshots()
+        self.assertFalse(MODULE.compare(before, before)['valid'])
+        after['targets'] = {}
+        self.assertFalse(MODULE.compare(before, after)['valid'])
+
+    def test_collector_is_read_only_and_records_identity(self):
+        commands = []
+
+        def fake(argv):
+            commands.append(argv)
+            if 'get' in argv:
+                return {'items': [{'metadata': {'name': 'target', 'uid': 'pod-uid'},
+                    'status': {'phase': 'Running', 'containerStatuses': [
+                        {'name': 'target', 'restartCount': 0, 'imageID': 'image-id'}]}}]}
+            if 'bdev_get_bdevs' in argv:
+                return [{'name': 'cache', 'uuid': 'cache-uuid',
+                         'driver_specific': {'readcache': {'base_bdev_name': 'raid'}}}]
+            if 'bdev_get_iostat' in argv:
+                return fixture()['targets']['rank/target']['iostat']
+            if 'bdev_readcache_get_stats' in argv:
+                return stats()
+            raise AssertionError(argv)
+
+        result = MODULE.snapshot(['rank'], require_cache=True, run=fake)
+        self.assertEqual(result['errors'], [])
+        self.assertEqual(result['targets']['rank/target']['uid'], 'pod-uid')
+        self.assertEqual(len(commands), 4)
+        self.assertTrue(all(command[0] == 'kubectl' for command in commands))
+        self.assertFalse(any('bdev_readcache_set_options' in command for command in commands))
+
+
+if __name__ == '__main__':
+    unittest.main()
